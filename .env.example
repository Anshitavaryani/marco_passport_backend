APP_NAME='Marco Passport'
PORT=5000

# MySQL
CENTRAL_MYSQL_HOST='localhost'
CENTRAL_MYSQL_USER='root'
CENTRAL_MYSQL_PASSWORD=''
CENTRAL_MYSQL_DB='marco_passport'
CENTRAL_MYSQL_PORT=3306

# JWT
JWT_SECRET='change-me'
# Minutes after which a user access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME='you@example.com'
SMTP_PASSWORD=''
EMAIL_FROM='you@example.com'

# Public site URL; email links point to <FRONTEND_URL>/verify-email and /reset-password
FRONTEND_URL='http://localhost:3000'

# Comma-separated list of allowed CORS origins
ACCESSDOMAINS='http://localhost:3000,http://localhost:3001'
DEFAULT_API_DATA_LIMIT=15
DEFAULT_TIMEZONE='UTC'

# Role/department ids — must match rows seeded from roles.sql / departments.sql
SUP_ADM_ROLE_ID=1
USR_ROLE_ID=6
ADM_DEPT_ID=1

# Used by `npm run auth` (the temporary password is emailed to this address)
SUPER_ADMIN_NAME='Super Admin'
SUPER_ADMIN_EMAIL='admin@example.com'
