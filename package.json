{
  "name": "marco-passport-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "public/uploads/**/*.*"
    ]
  },
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "staging": "pm2 start ecosystem.staging-config.json --no-daemon",
    "dev": "cross-env NODE_ENV=development nodemon --ext js,json index.js",
    "auth": "cross-env NODE_ENV=development node src/config/createSuperAdmin.js",
    "sync": "cross-env NODE_ENV=development node src/config/migrateTable.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:generate": "sequelize-cli migration:generate --name",
    "seed": "cross-env NODE_ENV=development node src/seeders/run.js"
  },
  "author": "CA",
  "license": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "http-status": "^1.7.4",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "password-validator": "^5.3.0",
    "sequelize": "^6.37.8",
    "slugify": "^1.6.9",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
