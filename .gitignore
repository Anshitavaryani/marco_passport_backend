# Dependencies
node_modules/

# Environment / secrets — never commit real credentials.
# .env.example (if you have one) should still be tracked.
.env
.env.*
!.env.example

# TLS/keys — nginx terminates TLS in this deployment, but keep any
# accidental local cert/key files out of git regardless.
*.pem
*.key
*.crt

# User-uploaded content (see multer.js / public/uploads/*) — this is
# runtime data, not source. Directories are recreated automatically on
# boot (multer.js calls fs.mkdirSync for each), so nothing here needs a
# .gitkeep placeholder.
public/uploads/*

# DB backups (see src/config/db_backup.js — writes timestamped, gzipped
# dumps here)
db_backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pm2 (in case pm2 is ever pointed at a local logs dir instead of the
# default ~/.pm2/logs)
.pm2/

# Test coverage, if/when a test suite is added
coverage/
.nyc_output/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Merge artifacts
*.orig
*.rej

# Misc caches
.cache/
.eslintcache

# Note: package-lock.json, .sequelizerc, migrations/, and seeders/dumps/
# are intentionally NOT ignored — they need to be committed for
# reproducible installs and consistent schema history across machines.